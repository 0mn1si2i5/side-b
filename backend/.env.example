# Side B Backend Configuration
# Copy this file to backend/.env and fill in your values:
#   cp backend/.env.example backend/.env

# Server configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8788

# Database
# SQLite is the v1 default for local development and personal-server Docker deploys.
DATABASE_URL=sqlite:///./data/sideb.db

# JWT Authentication
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_with_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS origins (comma-separated). Do not use wildcard (*) in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Spotify API credentials
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Apple Music storefront region
APPLE_MUSIC_STOREFRONT=cn

# Netease Cloud Music API base URL
# Docker compose overrides this to http://netease:3000.
NETEASE_API_BASE_URL=http://127.0.0.1:3000
NETEASE_REQUEST_TIMEOUT=10

# Optional Songlink API key, currently not required for the main resolver path.
SONGLINK_API_KEY=

# Debug mode enables uvicorn auto-reload when running via python -m app.main.
DEBUG=false
