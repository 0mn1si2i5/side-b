# Side B Backend Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Spotify API credentials (required for Spotify resolution)
# Get from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Songlink API key (optional, for cross-platform link aggregation)
SONGLINK_API_KEY=

# Apple Music storefront region (default: cn for China)
APPLE_MUSIC_STOREFRONT=cn

# Netease Cloud Music API base URL
# In Docker: use service name (http://netease:3000)
# Local: use http://127.0.0.1:3000
NETEASE_API_BASE_URL=http://127.0.0.1:3000
NETEASE_REQUEST_TIMEOUT=10

# Server configuration
HOST=0.0.0.0
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8788

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/sideb.db

# JWT Authentication
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_with_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS origins (comma-separated, or * for development)
# Production: https://yourdomain.com,sideb://
CORS_ORIGINS=*

# Rate limiting (enabled by default)
RATE_LIMIT_ENABLED=true